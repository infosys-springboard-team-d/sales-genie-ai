# Copy to .env and set local-only values. Never commit the populated .env.
POSTGRES_DB=salesgenie_dev
POSTGRES_USER=salesgenie
POSTGRES_PASSWORD=replace-with-a-unique-local-password
DATABASE_URL=sqlite:///./salesgenie.db
# For local PostgreSQL, use the same password above:
# DATABASE_URL=postgresql+psycopg://salesgenie:replace-with-a-unique-local-password@127.0.0.1:5432/salesgenie_dev
API_BASE_URL=http://127.0.0.1:8000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
