# Copy to .env and set local-only values. Never commit the populated .env.
POSTGRES_DB=salesgenie_dev
POSTGRES_USER=salesgenie
POSTGRES_PASSWORD=replace-with-a-unique-local-password
DATABASE_URL=sqlite:///./salesgenie.db
# For local PostgreSQL, use the same password above:
# DATABASE_URL=postgresql+psycopg://salesgenie:replace-with-a-unique-local-password@127.0.0.1:5432/salesgenie_dev
API_BASE_URL=http://127.0.0.1:8000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
# Optional CRM credentials; keep real values in the ignored local .env only.
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=
SALESFORCE_API_VERSION=v61.0
SALESFORCE_STATUS_MAPPING={"New":"Open - Not Contacted","Contacted":"Working - Contacted","Qualified":"Working - Contacted","Proposal":"Working - Contacted"}
# Leave empty until an existing Salesforce Opportunity stage mapping is approved.
SALESFORCE_DEAL_STAGE_MAPPING={}
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_LIFECYCLE_STAGE_MAPPING={"New":"lead","Contacted":"lead","Qualified":"salesqualifiedlead","Proposal":"opportunity","Won":"customer","Lost":"other"}
# Leave empty until an existing HubSpot deal stage mapping is approved.
HUBSPOT_DEAL_STAGE_MAPPING={}
